<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../RimWeave.local.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputPath>../examples/RimWeave.Example/Assemblies/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../RimWeave/RimWeave.csproj" Private="false" />

        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityStubs">
            <HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="Waylith">
            <HintPath>$(RimWorldDir)/Waylith.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>