<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>RimWeave_CompositionTemporary</defName>
        <label>composition B marker</label>
        <description>An explicitly added marker for the independent-consumer example.</description>
        <hediffClass>RimWeave.Health.ContributionHediff</hediffClass>
        <modExtensions>
            <li Class="RimWeave.Health.ContributionDefExtension">
                <ownerId>rimweave.example.peer</ownerId>
                <localId>hand-state</localId>
                <exclusiveResponsibility>rimweave.examples/hand-state</exclusiveResponsibility>
            </li>
        </modExtensions>
        <isBad>false</isBad>
        <makesAlert>false</makesAlert>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <tendable>false</tendable>
        <scenarioCanAdd>false</scenarioCanAdd>
    </HediffDef>
</Defs>
