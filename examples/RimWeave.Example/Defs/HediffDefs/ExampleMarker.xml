<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>RimWeave_ExampleMarker</defName>
        <label>example marker</label>
        <description>A marker used to inspect native health callbacks.</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>

        <isBad>false</isBad>
        <makesAlert>false</makesAlert>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <tendable>false</tendable>
        <scenarioCanAdd>false</scenarioCanAdd>

        <comps>
            <li>
                <compClass>RimWeave.Example.Health.HediffComp_FirstObserver</compClass>
            </li>
            <li>
                <compClass>RimWeave.Example.Health.HediffComp_SecondObserver</compClass>
            </li>
        </comps>
    </HediffDef>
</Defs>