<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../RimWeave.local.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <OutputPath>../mod/Assemblies/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityStubs">
            <HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="Waylith">
            <HintPath>$(RimWorldDir)/Waylith.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RimWeave.Tests" />
        <InternalsVisibleTo Include="RimWeave.Example" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>
</Project>
