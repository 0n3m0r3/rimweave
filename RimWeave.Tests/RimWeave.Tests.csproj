<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../RimWeave.local.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>RimWeave.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
        <PackageReference Include="xunit.runner.visualstudio"
                          Version="4.0.1"
                          PrivateAssets="all" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../RimWeave/RimWeave.csproj" />
        <ProjectReference Include="../RimWeave.Example/RimWeave.Example.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="UnityStubs">
            <HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Waylith">
            <HintPath>$(RimWorldDir)/Waylith.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

</Project>
